# Ship-It demo configuration. Copy to .env (git-ignored) and fill in the two
# credentials; docker compose and the Makefile targets both read this file.
#
#   cp .env.example .env
#   openssl rand -hex 24   # run twice (or three times) to mint the tokens below

# ---- Shared by the engine (docker compose) and every app process ----------

# Tenant API key. The compose file hands it to the engine as
# `--api-keys ${QUEUEFLOW_TOKEN}:shipit`; the web process, the Node worker and
# the Python worker present it on ordinary API calls. Required.
QUEUEFLOW_TOKEN=

# Worker-protocol credential (`--worker-token` on the engine). Used by both
# workers for lease/heartbeat/complete/fail. Required.
QUEUEFLOW_WORKER_TOKEN=

# ---- Web process (src/server.ts) ------------------------------------------

# Bearer token for mutating dispatch-office actions (DLQ replay, cron
# pause/resume). Leave empty to disable those buttons: they answer 503 and the
# read-only admin views stay open. Paste the same value into the dispatch
# office's "admin token" field.
SHIPIT_ADMIN_TOKEN=

# Where the app processes reach the engine's HTTP API.
# Default: http://localhost:8000 (the compose port mapping).
# On Railway: http://engine.railway.internal:8000
QUEUEFLOW_URL=http://localhost:8000

# Storefront port. Default 3100.
PORT=3100

# Per-IP budget for mutating /api routes (POST /api/orders, admin actions),
# per 60 second window. Default 20. Reads and the SSE tracker are not counted.
RATE_LIMIT_PER_MINUTE=20

# Set to 1 to trust one X-Forwarded-For hop when running behind a reverse
# proxy that is NOT Railway (Railway is detected from the RAILWAY_SERVICE_ID /
# RAILWAY_ENVIRONMENT_ID variables it injects into every service).
# Leave unset when the web process is reached directly.
TRUST_PROXY=

# ---- Workers (src/worker.ts) -----------------------------------------------

# Ambient chaos: probability that any single payment attempt fails.
# Bubble wrap orders ignore this and fail deterministically. Default 0.25.
PAYMENT_FAILURE_RATE=0.25
