# Where the QueueFlow engine listens (docker-compose default).
QUEUEFLOW_URL=http://localhost:8000

# Tenant credential: must match the server's --api-keys entry.
QUEUEFLOW_TOKEN=shipit-key

# Worker credential: must match the server's --worker-token.
QUEUEFLOW_WORKER_TOKEN=shipit-worker-token

# Port for the storefront + dispatch office.
PORT=3100

# Ambient chaos: probability that any payment attempt fails (0..1).
# Bubble Wrap orders ignore this and fail deterministically 3 times.
PAYMENT_FAILURE_RATE=0.25
